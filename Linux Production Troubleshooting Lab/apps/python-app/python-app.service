[Unit]
Description=Lab Python app (Flask/Gunicorn)
After=network.target

[Service]
Type=simple
User=labapp
WorkingDirectory=/opt/lab/python-app
EnvironmentFile=/opt/lab/python-app/.env
ExecStart=/opt/lab/python-app/venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=2
# Deliberately loose defaults for the lab; not for real production use.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
